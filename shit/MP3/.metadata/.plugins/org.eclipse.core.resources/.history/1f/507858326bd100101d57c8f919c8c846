// refill DMA half-buffer

static void refill_half_buffer(uint8_t half) {
    uint8_t *ptr = audio_buffer + (half ? AUDIO_DMA_HALF : 0);
    uint32_t samples = AUDIO_DMA_HALF / 2; // 16-bit samples

    // Simple ramp waveform (sawtooth) on both channels
    static uint16_t phase = 0;

    for (uint32_t i = 0; i < samples; i += 2) {
        uint16_t sample = phase;
        phase += 300; // change this value for different pitch

        // Left
        ptr[2*i + 0] = sample & 0xFF;
        ptr[2*i + 1] = (sample >> 8) & 0xFF;

        // Right
        ptr[2*i + 2] = sample & 0xFF;
        ptr[2*i + 3] = (sample >> 8) & 0xFF;
    }
}


