/**
  * @brief  Application entry point.
  */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DMA_Init();
  MX_FATFS_Init();
  MX_SPI1_Init();
  MX_USART2_UART_Init();
  MX_SAI1_Init();

  // LCD
  LCD_Init();
  LCD_Clear();
  LCD_DisplayString(0, (unsigned char *)"Mounting SD...");

  // --- DEBUG: Mount SD card ---
  myprintf("Mount...\r\n");
  if (f_mount(&USERFatFS, USERPath, 1) != FR_OK)
  {
      myprintf("Mount failed\r\n");
      Error_Handler();
  }
  myprintf("Mount OK\r\n");

  // --- DEBUG: Open and parse WAV file ---
  int r = start_wav_playback("0:/test.wav");
  myprintf("start_wav_playback returned %d\r\n", r);
  if (r != 0)
  {
      myprintf("Failed to open/parse test.wav\r\n");
      Error_Handler();
  }

  // --- DEBUG: print WAV info ---
  myprintf("WAV: rate=%lu, bits=%u, ch=%u, data=%lu bytes\r\n",
           wavinfo.sample_rate,
           wavinfo.bits_per_sample,
           wavinfo.num_channels,
           wavinfo.data_bytes);

  // Update LCD with song name
  LCD_Clear();
  LCD_DisplayString(0, (unsigned char *)"Playing:");
  LCD_DisplayString(1, (unsigned char *)current_song_name);

  // Prime audio buffers
  refill_half_buffer(0);
  refill_half_buffer(1);

  // Start DMA audio transmit
  HAL_SAI_Transmit_DMA(&hsai_BlockA1, (uint8_t*)audio_buffer, AUDIO_BUFFER_BYTES/2);

  while (1)
  {
      if (half_transfer_flag) {
          half_transfer_flag = 0;
          refill_half_buffer(0);
          myprintf("half\r\n");   // DEBUG: show half-buffer interrupt
      }
      if (full_transfer_flag) {
          full_transfer_flag = 0;
          refill_half_buffer(1);
          myprintf("full\r\n");   // DEBUG: show full-buffer interrupt
      }

      // optional heartbeat:
      // myprintf("loop\r\n");
      // HAL_Delay(500);
  }
}


