#include "stm32l476xx.h"

#define LCD_Port GPIOB
#define LCD_RS (1 << 0) // RS: 0 = command, 1 = data
#define LCD_EN (1 << 1)

#define LCD_D4 (1 << 2)
#define LCD_D5 (1 << 3)
#define LCD_D6 (1 << 4)
#define LCD_D7 (1 << 5)

void LCD_putNibble(uint8_t c) {
    if(c & 0x8)
        LCD_Port->ODR |= LCD_D7;
    else
        LCD_Port->ODR &= ~LCD_D7;

    if(c & 0x4)
        LCD_Port->ODR |= LCD_D6;
    else
        LCD_Port->ODR &= ~LCD_D6;

    if(c & 0x2)
        LCD_Port->ODR |= LCD_D5;
    else
        LCD_Port->ODR &= ~LCD_D5;

    if(c & 0x1)
        LCD_Port->ODR |= LCD_D4;
    else
        LCD_Port->ODR &= ~LCD_D4;
}

// reuse HAL_Delay for ms delays
#define delay_ms HAL_Delay

void LCD_Pulse(void){
    LCD_Port->ODR |= LCD_EN;
    delay_ms(4);
    LCD_Port->ODR &= ~(LCD_EN);
    delay_ms(4);
}

void LCD_WriteCom(unsigned char com) {
    unsigned char com1, com2;
    com1 = com & 0x0F;
    com2 = (com >> 4) & 0x0F;

    GPIOB->ODR &= ~LCD_RS;
    delay_ms(1);

    LCD_putNibble(com2);
    LCD_Pulse();

    LCD_putNibble(com1);
    LCD_Pulse();
}

void LCD_WriteData(unsigned char dat) {
    unsigned char dat1, dat2;
    dat1 = dat & 0x0F;
    dat2 = (dat >> 4) & 0x0F;

    GPIOB->ODR |= LCD_RS;
    delay_ms(1);

    LCD_putNibble(dat2);
    LCD_Pulse();

    LCD_putNibble(dat1);
    LCD_Pulse();
}

void LCD_Init(void){
    // GPIOB clock (also enabled in MX_GPIO_Init, but double-enable is harmless)
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOBEN;

    // PB0–PB5 as outputs
    GPIOB->MODER &= 0xFFFFF000;
    GPIOB->MODER |= 0x00000555;

    delay_ms(30);
    LCD_WriteCom(0x03);
    delay_ms(5);

    LCD_WriteCom(0x03);
    delay_ms(5);
    LCD_WriteCom(0x03);
    delay_ms(5);
    LCD_WriteCom(0x02);
    delay_ms(5);

    LCD_WriteCom(0x28); // 4-bit, 2 lines, 5x8 font
    delay_ms(5);
    LCD_WriteCom(0x0C); // display on, cursor off
    delay_ms(5);
    LCD_WriteCom(0x06); // entry mode: increment, no shift
    delay_ms(5);
    LCD_WriteCom(0x01); // clear
    delay_ms(5);
}

void LCD_Clear(void){
    LCD_WriteCom(0x01);
    delay_ms(5);
}

void LCD_DisplayString(unsigned int line, unsigned char *ptr) {
    int i;
    if (line == 0){
        LCD_WriteCom(0x80);
    }
    else{
        LCD_WriteCom(0xC0);
    }
    for (i = 0; i < 16 && ptr[i] != '\0'; i++){
        LCD_WriteData(ptr[i]);
    }
}
