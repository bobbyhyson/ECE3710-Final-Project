UINT sd_read_bytes(uint8_t *buf, UINT len)
{
    UINT br;
    // IMPORTANT: read from wav_file, the one we opened in start_wav_playback
    FRESULT res = f_read(&wav_file, buf, len, &br);
    (void)res;  // could check for errors if you want
    return br;  // number of bytes actually read
}

void myprintf(const char *fmt, ...) {
  static char buffer[256];
  va_list args;
  va_start(args, fmt);
  vsnprintf(buffer, sizeof(buffer), fmt, args);
  va_end(args);

  int len = strlen(buffer);
  HAL_UART_Transmit(&huart2, (uint8_t*)buffer, len, HAL_MAX_DELAY);
}

